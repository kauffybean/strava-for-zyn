modules = ["nodejs-20"]

[nix]
channel = "stable-24_05"

[workflows]
runButton = "Build and Start"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Zynfantry Server"

[[workflows.workflow]]
name = "Zynfantry Server"
author = "agent"

[workflows.workflow.metadata]
agentRequireRestartOnSave = false

[[workflows.workflow.tasks]]
task = "packager.installForAll"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "node start-prod.js"
waitForPort = 5000

[[workflows.workflow]]
name = "Build and Start"
author = 40597245
mode = "sequential"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "cd client && npm run build"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "cd .."

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "cd server && npx tsc"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "cd .."

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "node start-prod.js"

[deployment]
run = ["sh", "-c", "cd server && NODE_ENV=production PORT=3000 node dist/index.js"]
build = ["sh", "-c", "npm install && cd server && mkdir -p dist && npx tsc"]

[[ports]]
localPort = 3000
externalPort = 80

[[ports]]
localPort = 5000
externalPort = 5000
